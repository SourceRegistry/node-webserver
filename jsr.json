{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@sourceregistry/node-webserver",
  "version": "1.6.3",
  "exports": {
    ".": "./jsr/index.js"
  },
  "publish": {
    "include": [
      "jsr/**/*.js",

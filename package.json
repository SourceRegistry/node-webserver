{
  "name": "@sourceregistry/node-webserver",
  "version": "1.10.0",
  "description": "TypeScript web server for Node.js with web-standard Request and Response APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && vite build && npm run build:jsr-package",
    "build:jsr-types": "node scripts/build-jsr-types.mjs",
    "build:jsr-package": "npm run build:jsr-types && node scripts/build-jsr-package.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs:build": "typedoc src/index.ts --out generated/docs --name \"node-webserver\" --excludePrivate --excludeProtected",
    "examples/simple": "tsx examples/simple.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SourceRegistry/node-webserver.git"
  },
  "keywords": [
    "webserver",
    "http",
    "https",
    "router",
    "middleware",
    "websocket",
    "fetch",
    "request",
    "response",
    "typescript",
    "node",
    "nodejs",
    "web-standard"
  ],
  "author": "Alexander Slaa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/SourceRegistry/node-webserver/issues"
  },
  "homepage": "https://sourceregistry.github.io/node-webserver/",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sourceregistry/semantic-release-jsr": "^1.1.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsr": "^0.14.3",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      [
        "@sourceregistry/semantic-release-jsr",
        {
          "pkgRoot": "generated/jsr-publish",
          "configFile": "jsr.json",
          "allowSlowTypes": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "jsr.json",
            "CHANGELOG.md"
          ],
          "message": "node-webserver(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}

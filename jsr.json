{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@sourceregistry/node-webserver",
  "version": "1.6.5",
  "exports": {
    ".": "./jsr/index.js"
  },
  "publish": {
    "include": [
      "jsr/**/*.js",
      "jsr/**/*.d.ts",
      "dist/**/*.js",
      "generated/jsr-types/**/*.d.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "!dist",
      "!generated/jsr-types"
    ]
  }
}
